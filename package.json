{
  "name": "tsumugi-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx tools/scripts/dev.ts",
    "build": "tsx tools/scripts/build-tokens.ts --check && tsx tools/scripts/build-public.ts && next build && tsx tools/scripts/postbuild.ts",
    "check": "tsc --noEmit && tsx tools/scripts/check-structure.ts && tsx tools/scripts/check-content.ts && tsx tools/scripts/check-styles.ts && npm run check:unused",
    "verify": "tsx tools/verify/verify.ts",
    "tokens": "tsx tools/scripts/build-tokens.ts",
    "og": "tsx tools/scripts/og.ts",
    "lint": "eslint . --config config/eslint.config.ts --max-warnings=0",
    "test": "vitest run --config config/vitest.config.ts",
    "test:watch": "vitest --config config/vitest.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run check && npm run lint && npm test && npm run test:pricing && npm run build && npm run verify -- --static",
    "deploy:preview": "vercel",
    "deploy:production": "vercel --prod",
    "styles": "tsx tools/scripts/build-styles.ts",
    "styles:watch": "tsx tools/scripts/build-styles.ts --watch",
    "test:pricing": "tsx --test tools/pricing/model.test.ts",
    "report:pricing": "tsx tools/pricing/report.ts",
    "check:unused": "knip --config config/knip.config.ts",
    "check:live": "tsx tools/ops/cli/check-live.ts"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "1.45.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "jiti": "2.7.0",
    "knip": "6.35.1",
    "parse5": "8.0.1",
    "playwright": "1.63.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "npm:@typescript/typescript6@6.0.3",
    "vercel": "59.16.0",
    "vitest": "5.0.0"
  },
  "overrides": {
    "@tootallnate/once": "2.0.1",
    "ajv@^8": "8.20.0",
    "minimatch@^10": "10.2.6",
    "path-to-regexp@6.1.0": "6.3.0",
    "path-to-regexp@^8": "8.4.0",
    "smol-toml": "1.8.0",
    "tar@^7": "7.5.22",
    "js-yaml@^4": "4.3.2",
    "esbuild@^0.27": "0.28.2",
    "undici@<7": "6.28.0"
  },
  "packageManager": "npm@12.0.2",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true,
    "@parcel/watcher@2.5.1": false
  },
  "prettier": "./config/prettier.json"
}
