{
  "$description": "紬の3色設計。アイボリー70・エスプレッソ20・琥珀10をUIの面積配分の目安にする。色の原値はmain/sub/accentだけ。src/styles/tokens.cssは生成物。",
  "color": {
    "$type": "color",
    "main": {
      "$value": "#FFF8ED",
      "$description": "メイン70%：アイボリー。背景・余白・反転文字"
    },
    "sub": {
      "$value": "#302820",
      "$description": "サブ20%：エスプレッソ。本文・説明の面・構造線"
    },
    "accent": {
      "$value": "#FFB000",
      "$description": "アクセント10%：琥珀。主要操作・重要な数字・相談の面"
    },
    "header-paper": { "$value": "{color.main}" },
    "header-ink": { "$value": "{color.sub}" },
    "header-brass": { "$value": "{color.accent}" },
    "white": { "$value": "{color.main}" },
    "ink": { "$value": "{color.sub}" },
    "panel": { "$value": "{color.sub}" },
    "black": { "$value": "{color.sub}" },
    "surface": { "$value": "{color.main}" },
    "field": { "$value": "{color.main}" },
    "paper": { "$value": "{color.main}" },
    "line": { "$value": "color-mix(in srgb, var(--color-sub) 20%, var(--color-main))" },
    "line-strong": { "$value": "color-mix(in srgb, var(--color-sub) 45%, var(--color-main))" },
    "green": { "$value": "{color.accent}" },
    "green-deep": { "$value": "color-mix(in srgb, var(--color-accent) 25%, var(--color-sub))" },
    "blue": { "$value": "{color.accent}" },
    "muted": { "$value": "color-mix(in srgb, var(--color-sub) 78%, var(--color-main))" },
    "muted-on-ink": { "$value": "color-mix(in srgb, var(--color-main) 82%, var(--color-sub))" },
    "alert": { "$value": "{color.sub}" },
    "alert-bg": { "$value": "{color.main}" },
    "ok": { "$value": "{color.green-deep}" },
    "ok-bg": { "$value": "{color.main}" },
    "warn": { "$value": "{color.sub}" },
    "warn-bg": { "$value": "{color.main}" }
  },
  "theme": {
    "$type": "color",
    "campaign": {
      "accent": { "$value": "{color.accent}" },
      "accent-ink": {
        "$value": "{color.sub}",
        "$description": "琥珀の面はエスプレッソの文字。小さい文字も薄めない"
      },
      "accent-text": {
        "$value": "{color.green-deep}",
        "$description": "白地に置く強調文字・リンク"
      }
    },
    "main": {
      "accent": { "$value": "{color.accent}" },
      "accent-ink": { "$value": "{color.sub}" },
      "accent-text": { "$value": "{color.green-deep}" }
    }
  },
  "size": {
    "$type": "dimension",
    "home-container": {
      "$value": "1280px",
      "$description": "ホーム本文。図解と比較のための広い器"
    },
    "header-pc": { "$value": "88px" },
    "header-mb": { "$value": "72px" },
    "pad-pc": {
      "$value": "48px",
      "$description": "PC 外側の余白"
    },
    "pad-hero": {
      "$value": "80px",
      "$description": "ヒーローの外側"
    },
    "pad-mb": {
      "$value": "24px",
      "$description": "モバイル本文"
    },
    "pad-mb-head": {
      "$value": "20px",
      "$description": "モバイルヘッダー"
    },
    "container": {
      "$value": "1104px",
      "$description": "3列 × 間隔32px の器"
    },
    "measure-wide": { "$value": "1048px" },
    "measure-read": {
      "$value": "720px",
      "$description": "本文の読み幅の上限"
    },
    "gap": { "$value": "32px" },
    "gap-near": {
      "$value": "12px",
      "$description": "関係の近い情報 8–16px"
    },
    "gap-group": {
      "$value": "28px",
      "$description": "同じカードのまとまり 24–32px"
    },
    "section-pc": {
      "$value": "72px",
      "$description": "章の切り替え。見出しと本文が離れすぎない余白"
    },
    "section-mb": { "$value": "56px" },
    "cta-w-pc": { "$value": "315px" },
    "cta-h-pc": { "$value": "57px" },
    "cta-w-mb": { "$value": "260px" },
    "cta-h-mb": { "$value": "48px" },
    "tap": {
      "$value": "44px",
      "$description": "本ガイドの推奨。WCAG AA の必須値ではない"
    },
    "field-h": { "$value": "48px" },
    "card-w": { "$value": "318px" },
    "card-media-h": { "$value": "369px" },
    "bp": { "$value": "768px" },
    "cq-4": {
      "$value": "960px",
      "$description": "配置領域がこれ以上なら4列"
    },
    "cq-2": {
      "$value": "520px",
      "$description": "これ以上なら2列、未満は1列"
    }
  },
  "radius": {
    "$type": "dimension",
    "media": { "$value": "8px" },
    "card": { "$value": "4px" },
    "panel": { "$value": "4px" },
    "pill": { "$value": "999px" }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "brand": {
        "$value": [
          "Hiragino Mincho ProN",
          "Yu Mincho",
          "YuMincho",
          "Noto Serif CJK JP",
          "serif"
        ],
        "$description": "屋号・ブランドコピー・ページ見出しに使う端末の明朝。外部フォント不要"
      },
      "ja": {
        "$value": [
          "YakuHanJP",
          "Hiragino Sans",
          "Hiragino Kaku Gothic ProN",
          "Meiryo",
          "Helvetica Neue",
          "Helvetica",
          "Arial",
          "sans-serif"
        ]
      },
      "display": {
        "$value": [
          "League Gothic",
          "Haettenschweiler",
          "Arial Narrow",
          "sans-serif"
        ],
        "$description": "短い欧文のみ。日本語本文・長い項目名には使わない"
      },
      "mono": {
        "$value": [
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Consolas",
          "monospace"
        ]
      }
    },
    "size": {
      "$type": "dimension",
      "display-pc": { "$value": "145px" },
      "display-mb": { "$value": "90px" },
      "hero-pc": { "$value": "45px" },
      "hero-mb": { "$value": "24px" },
      "page-pc": {
        "$value": "42px",
        "$description": "ページ見出し 28–42px"
      },
      "page-mb": { "$value": "28px" },
      "h2": { "$value": "28px" },
      "h3": { "$value": "20px" },
      "label": {
        "$value": "14px",
        "$description": "セクションラベル 14–20px"
      },
      "body": {
        "$value": "16px",
        "$description": "業務本文と入力は 16px"
      },
      "fine": {
        "$value": "14px",
        "$description": "注記・添え字・表の補足・ボタンやラベルの下限。10.5pt（旧 12px＝9pt から +1.5pt）。これより小さい文字を作らない"
      },
      "meta": {
        "$value": "{font.size.fine}",
        "$description": "補助文。旧 PC 13px・モバイル 14px を下限にそろえる"
      }
    },
    "tracking": {
      "$type": "dimension",
      "body": {
        "$value": "0.04em",
        "$description": "和文の字間。palt で詰まる字面を控えめに開く。空白の挿入で代用しない"
      },
      "heading": {
        "$value": "0.02em",
        "$description": "見出し。大きい字は開きすぎない"
      }
    },
    "leading": {
      "$type": "number",
      "hero": { "$value": 1.5 },
      "heading": { "$value": 1.5 },
      "body": { "$value": 1.8 }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semi": { "$value": 600 },
      "bold": { "$value": 700 }
    }
  },
  "motion": {
    "$type": "duration",
    "fast": {
      "$value": "160ms",
      "$description": "操作への反応"
    },
    "panel": {
      "$value": "280ms",
      "$description": "パネル・切り替え"
    },
    "reveal": {
      "$value": "600ms",
      "$description": "説明ページの初回出現"
    }
  },
  "ratio": {
    "$type": "number",
    "display-correction": {
      "$value": 0.9643,
      "$description": "無料代替書体の幅補正。契約済みの原書体に変えるときは 1 に戻して再計測する"
    }
  }
}
