---
import Icon from './Icon.astro';
import type { IconName } from '../data/icons';
/** アイコンは状態を示すとき（warn / bad）だけ付ける（原則E） */
interface Props { heading: string; kind?: '' | 'good' | 'warn' | 'bad' }
const { heading, kind = '' } = Astro.props;
const ICON: Record<string, IconName> = { warn: 'triangle-alert', bad: 'circle-x' };
const icon = ICON[kind];
---
<div class={`alert${kind ? ' ' + kind : ''}`}>
  {icon && <Icon name={icon} />}
  <div class="bd"><span class="h" set:html={heading} /><slot /></div>
</div>
