---
/**
 * Lucide を SVG で直接埋め込む。実行時JSは使わない。
 * 大きさは px ではなく em（隣の文字に対する比）で decided ── CSS 側の .ic / .ic-sm。
 */
import { ICONS, type IconName } from '../data/icons';
interface Props { name: IconName; sm?: boolean; class?: string }
const { name, sm = false, class: cls = '' } = Astro.props;
const path = ICONS[name];
if (!path) throw new Error(`unknown icon: ${name}`);
const klass = ['ic', sm ? 'ic-sm' : '', cls].filter(Boolean).join(' ');
---
<svg class={klass} viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="true" focusable="false" set:html={path} />
