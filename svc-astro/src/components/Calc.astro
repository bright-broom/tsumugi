---
import Icon from './Icon.astro';
import type { IconName } from '../data/icons';
/** 追える計算。金額の行を積み上げて、最後に結論を1行置く */
interface Row { label: string; value?: string; cls?: '' | 'small' | 'sum' | 'net' | 'minus'; sub?: string; icon?: IconName }
interface Props { title: string; rows: Row[] }
const { title, rows } = Astro.props;
---
<div class="calc">
  <div class="ttl" set:html={title} />
  {rows.map((r) => (
    <div class={`r ${r.cls ?? ''}`.trim()}>
      <span class="k"><span>
        {r.icon && <Icon name={r.icon} />}
        <Fragment set:html={r.label} />
        {r.sub && <em set:html={r.sub} />}
      </span></span>
      <span class="v tnum" set:html={r.value ?? ''} />
    </div>
  ))}
</div>
