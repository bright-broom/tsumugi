---
import Icon from './Icon.astro';
import type { IconName } from '../data/icons';
interface Props { items: { icon: IconName; value: string | number; unit?: string; label: string }[] }
const { items } = Astro.props;
---
<div class="stats">{items.map((s) => (
  <div class="stat"><Icon name={s.icon} sm />
    <div class="v tnum">{s.value}{s.unit ?? ''}</div>
    <div class="k">{s.label}</div></div>
))}</div>
