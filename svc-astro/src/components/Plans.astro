---
import * as P from '../data/prices';
/** プランは3枚並列にしない。真ん中を大きくして、選ぶ理由を書く。
    支払い方の切り替えはラジオ＋:has()で、JavaScriptは使わない。 */
interface Props { withSwitch?: boolean; feat?: number }
const { withSwitch = true, feat = 6 } = Astro.props;
const RUN_FOR = { basic: 'run_basic', standard: 'run_standard', pro: 'run_growth' } as const;
---
{withSwitch && (
  <div class="switcher">
    <div class="seg" role="group" aria-label="お支払い方法の表示切り替え">
      <input type="radio" name="pay" id="pm" checked /><label for="pm">毎月払う</label>
      <input type="radio" name="pay" id="pb" /><label for="pb">まとめて払う</label>
    </div>
    <p class="segnote"><span>
      <span class="n-m">制作費{P.INSTALLMENT_COUNT}回＋運用費の合計です。手数料0円なので総額は同じ。</span>
      <span class="n-b">制作費を一度で払う場合。このあと運用費が毎月かかります。</span>
    </span></p>
    <div class="cq"><div class="plans">
      {P.BUILD.map((p) => {
        const ins = P.INSTALLMENT[p.key];
        const rn = P.run(RUN_FOR[p.key]);
        const pick = 'recommended' in p && p.recommended;
        const monthly = ins.monthly + rn.price;
        return (
          <div class={`plan${pick ? ' pick' : ''}`}>
            {pick && <span class="tag">迷ったらこれです</span>}
            <div class="pn">{p.name}</div>
            <div class="pmeta">{p.pages}ページ・約{p.weeks}週間でお渡し</div>
            <div class="pv">
              <span class="v-m">
                <span class="amt tnum">{monthly.toLocaleString('en-US')}<span class="u">円／月</span></span>
                <span class="sub2">初回 {ins.initial.toLocaleString('en-US')}円 ＋ 毎月 {ins.monthly.toLocaleString('en-US')}円×{P.INSTALLMENT_COUNT}回
                  ＋ 運用 {rn.price.toLocaleString('en-US')}円／月</span>
              </span>
              <span class="v-b">
                <span class="amt tnum">{p.price.toLocaleString('en-US')}<span class="u">円</span></span>
                <span class="sub2">一度だけ。このあと運用 {rn.price.toLocaleString('en-US')}円／月</span>
              </span>
            </div>
            <div class="why">{p.lede}</div>
            <ul>{p.includes.slice(0, feat).map((i) => <li>{i}</li>)}</ul>
            {feat < p.includes.length && (
              <a class="more" href="price.html">ほか{p.includes.length - feat}項目</a>)}
            <div class="flex"></div>
            <a class={`btn ${pick ? 'btn-1' : 'btn-2'}`} href="contact.html">このプランで相談する</a>
          </div>
        );
      })}
    </div></div>
  </div>
)}
